{
	"name": "flame",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.2.8",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1",
		"wrangler": "^4.141.0"
	},
	"scripts": {
		"postinstall": "wrangler types --strict-vars=false",
		"build": "esbuild ../client/flame.js --bundle --format=iife --target=es2017 --define:define=undefined --log-level=warning --outfile=dist/public/flame.js && esbuild ../client/flame.js --bundle --format=iife --target=es2017 --define:define=undefined --log-level=warning --minify --outfile=dist/public/flame.min.js",
		"dev": "wrangler dev",
		"pretest": "npm run build",
		"test": "vitest run",
		"check": "wrangler types --strict-vars=false && tsc -p . && tsc -p test"
	}
}
