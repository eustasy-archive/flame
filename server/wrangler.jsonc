{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flame",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-25",
	// Node.js compatibility is on by default from 2026-08-04. Flame only uses web
	// APIs, so it's turned off.
	"compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
	"observability": {
		"enabled": true
	},
	// Workers Cache: Cloudflare caches GET responses in front of the Worker, by
	// path and query string, following their Cache-Control and Vary headers.
	"cache": {
		"enabled": true
	},
	// The /trending queries in ../sql are imported as text.
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	// Builds the client bundle into dist/public before `wrangler dev` and `wrangler deploy`.
	"build": {
		"command": "npm run build"
	},
	"vars": {
		// Hostnames that may send data to /track and read /trending, separated by
		// commas. "*.example.com" matches any subdomain of example.com, but not
		// example.com itself. Nothing is allowed if this is empty.
		"ALLOWED_DOMAINS": "example.com, *.example.com",
		// /trending queries Analytics Engine's SQL API, which needs the account ID
		// and the dataset's name, plus a CF_API_TOKEN secret.
		"CF_ACCOUNT_ID": "",
		"ANALYTICS_DATASET": "flame"
	},
	// Pageviews and events. See sql/README.md for the layout.
	"analytics_engine_datasets": [
		{
			"binding": "FLAME",
			"dataset": "flame"
		}
	],
	"assets": {
		"directory": "./dist/public",
		"binding": "ASSETS",
		// The Worker picks which build to serve, so it sees every request first.
		"run_worker_first": true
	}
}
